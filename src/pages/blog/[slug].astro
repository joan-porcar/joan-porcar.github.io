---
// src/pages/blog/[slug].astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 1. Generar las rutas dinámicas para cada post en base a su slug
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

// 2. Recuperar la entrada específica de los props
const { entry } = Astro.props;
const { Content } = await entry.render();

// Formatear fecha de manera limpia
const formattedDate = entry.data.pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Redes sociales y canales
const LINKEDIN_URL = "https://www.linkedin.com/in/joan-porcar-pujol/";
const WHATSAPP_CHANNEL_URL = "https://whatsapp.com/channel/0029VbDD7ATIHph8xnry1F2o";
---

<Layout 
  title={`${entry.data.title} | Joan Porcar`} 
  description={entry.data.description} 
  maxWidth="3xl"
>
  <style>
      /* Estilos específicos para inyectar el diseño premium al HTML renderizado desde Markdown */
      .prose p {
          margin-bottom: 1.5rem;
          color: #94A3B8;
          font-size: 1.05rem;
          line-height: 1.8;
      }
      .prose h2 {
          color: #FFFFFF;
          font-weight: 700;
          font-size: 1.75rem;
          margin-top: 2.5rem;
          margin-bottom: 1rem;
          letter-spacing: -0.025em;
      }
      .prose h3 {
          color: #FFFFFF;
          font-weight: 700;
          font-size: 1.4rem;
          margin-top: 2rem;
          margin-bottom: 0.75rem;
      }
      .prose em {
          color: #38BDF8;
          font-style: italic;
      }
      .prose strong {
          color: #FFFFFF;
          font-weight: 600;
      }
      .prose blockquote {
          border-left: 3px solid #38BDF8;
          padding-left: 1.25rem;
          font-style: italic;
          margin: 2rem 0;
          color: #CBD5E1;
      }
      .prose pre {
          background-color: #0A0A0C !important;
          border: 1px solid #334155/60;
          padding: 1.25rem;
          border-radius: 0.75rem;
          overflow-x: auto;
          margin: 2rem 0;
      }
      .prose code {
          font-size: 0.9rem;
          color: #E2E8F0;
      }
  </style>

    <!-- Contenedor Principal del Post -->
    <main class="max-w-3xl mx-auto px-6 py-16 space-y-10">
        
        <!-- Enlace de Retorno -->
        <a href="/" class="inline-flex items-center text-xs font-semibold text-[#38BDF8] hover:underline group gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Volver a la bitácora
        </a>

        <!-- Encabezado del Artículo -->
        <header class="space-y-4 border-b border-zinc-800/40 pb-8">
            <div class="flex items-center gap-3 text-xs text-zinc-500">
                <time datetime={entry.data.pubDate.toISOString()}>{formattedDate}</time>
                <span>&bull;</span>
                <span>{entry.data.readingTime}</span>
            </div>
            
            <h1 class="text-3xl md:text-5xl font-bold text-white tracking-tight leading-tight">
                {entry.data.title}
            </h1>

            <div class="flex flex-wrap gap-2 pt-2">
                {entry.data.tags.map((tag) => (
                    <span class="text-[10px] tracking-wider uppercase font-semibold text-zinc-400 bg-zinc-900/60 px-2 py-0.5 rounded border border-zinc-800/40">
                        #{tag}
                    </span>
                ))}
            </div>
        </header>

        <!-- Contenido Inyectado (Markdown Dinámico) -->
        <article class="prose max-w-none">
            <Content />
        </article>

        <!-- Bloque de Cierre al final de la lectura -->
        <footer class="mt-16 pt-8 border-t border-zinc-800/50">
            
            <!-- Barra de Herramientas Social / Compartir -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-xl bg-zinc-900/20 border border-zinc-800/40 backdrop-blur-sm shadow-md">
                <span class="text-xs font-semibold text-[#38BDF8]">¿Te ha hecho pensar? Comparte, sígueme y únete al canal.</span>
                <div class="flex flex-wrap items-center gap-3">
                    
                    <!-- Botón Compartir (Copiar Enlace) -->
                    <button
                        id="copy-link-btn"
                        class="flex items-center gap-1.5 px-3 py-2 rounded-lg bg-zinc-900/60 border border-zinc-800/60 text-xs font-medium text-zinc-300 hover:text-[#38BDF8] hover:border-[#38BDF8]/40 hover:bg-zinc-800/50 transition-all duration-300 active:scale-95 cursor-pointer"
                        aria-label="Copiar enlace del artículo al portapapeles"
                    >
                        <span id="copy-icon-wrapper" class="flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                            </svg>
                        </span>
                        <span id="copy-btn-text">Copiar enlace</span>
                    </button>

                    <!-- Enlace LinkedIn -->
                    <a
                        href={LINKEDIN_URL}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-1.5 px-3 py-2 rounded-lg bg-zinc-900/60 border border-zinc-800/60 text-xs font-medium text-zinc-300 hover:text-[#38BDF8] hover:border-[#38BDF8]/40 hover:bg-zinc-800/50 transition-all duration-300"
                        aria-label="Seguir en LinkedIn"
                    >
                        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                        <span>LinkedIn</span>
                    </a>

                    <!-- Enlace Canal WhatsApp -->
                    <a
                        href={WHATSAPP_CHANNEL_URL}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-1.5 px-3 py-2 rounded-lg bg-zinc-900/60 border border-zinc-800/60 text-xs font-medium text-zinc-300 hover:text-[#38BDF8] hover:border-[#38BDF8]/40 hover:bg-zinc-800/50 transition-all duration-300"
                        aria-label="Ir al canal de WhatsApp de Joan Porcar"
                    >
                        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.262 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.625 1.451 5.403.002 9.803-4.381 9.805-9.768.001-2.61-1.01-5.064-2.848-6.905C16.386 2.091 13.937 1.08 11.332 1.08 5.932 1.08 1.533 5.461 1.531 10.849c-.001 1.54.417 3.047 1.214 4.38l-.999 3.648 3.73-.977l-.001-.001zM17.432 14.1c-.318-.159-1.883-.93-2.174-1.036-.291-.106-.503-.159-.715.159-.211.318-.82.103-1.006.318-.185.215-.37.24-.688.082-.318-.159-1.341-.494-2.55-1.577-.94-.84-1.575-1.878-1.76-2.196-.185-.318-.02-.489.14-.647.143-.142.318-.371.477-.557.16-.186.212-.318.318-.53.106-.212.053-.397-.026-.557-.08-.159-.715-1.724-.98-2.36-.258-.62-.522-.536-.715-.546-.185-.01-.397-.012-.609-.012s-.556.08-.847.397c-.292.318-1.112 1.087-1.112 2.65 0 1.563 1.139 3.076 1.298 3.289.159.212 2.24 3.42 5.427 4.793.758.327 1.35.522 1.812.669.76.241 1.452.207 2.001.125.612-.091 1.883-.77 2.148-1.478.265-.707.265-1.314.185-1.442-.08-.127-.291-.207-.61-.366z"/>
                        </svg>
                        <span>Canal</span>
                    </a>
                </div>
            </div>
        </footer>

        <!-- Script de interactividad en el cliente para el botón de copiar enlace -->
        <script>
            const copyBtn = document.getElementById("copy-link-btn");
            const copyIconWrapper = document.getElementById("copy-icon-wrapper");
            const copyBtnText = document.getElementById("copy-btn-text");

            if (copyBtn && copyIconWrapper && copyBtnText) {
                const originalSvg = copyIconWrapper.innerHTML;
                const checkSvg = `
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-3.5 w-3.5 text-green-400">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                `;

                copyBtn.addEventListener("click", async () => {
                    try {
                        await navigator.clipboard.writeText(window.location.href);
                        
                        // Estado visual: Copiado
                        copyIconWrapper.innerHTML = checkSvg;
                        copyBtnText.textContent = "¡Copiado!";
                        copyBtn.classList.add("border-green-500/40", "text-green-400");
                        copyBtn.classList.remove("text-zinc-300", "hover:text-[#38BDF8]", "hover:border-[#38BDF8]/40");
                        
                        // Volver a estado original tras 2 segundos
                        setTimeout(() => {
                            copyIconWrapper.innerHTML = originalSvg;
                            copyBtnText.textContent = "Copiar enlace";
                            copyBtn.classList.remove("border-green-500/40", "text-green-400");
                            copyBtn.classList.add("text-zinc-300", "hover:text-[#38BDF8]", "hover:border-[#38BDF8]/40");
                        }, 2000);
                    } catch (err) {
                        console.error("Error al copiar el enlace: ", err);
                    }
                });
            }
        </script>

    </main>
</Layout>
